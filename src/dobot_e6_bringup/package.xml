<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_e6_bringup</name>
  <version>0.1.0</version>
  <description>Haptic-teleop ultrasound simulation on the Dobot ME6
    (port of kinova_us_bringup; see HANDOFF_dobot_e6.md).</description>
  <maintainer email="marino@calcagni.eu">marino</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>python3-evdev</exec_depend>
  <exec_depend>dobot_e6_description</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
