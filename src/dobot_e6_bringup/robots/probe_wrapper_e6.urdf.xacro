<?xml version="1.0"?>
<!--
  Wrapper that adds an ultrasound probe + Gazebo (Harmonic) force/torque sensor
  to the stock Dobot ME6. It includes the vendored me6 URDF unchanged and only
  APPENDS links/joints/gazebo tags plus the gz_ros2_control system (the vendor
  file carried a Gazebo-Classic block, stripped during vendoring).
  Do not edit dobot_e6_description; edit here.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="me6_robot">

  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="initial_positions_file" default="" />

  <!-- Tool centre point: where teleop rotations pivot and translations are
       measured. Offset from the flange (Link6) in metres, Link6 frame.
       Default (0, 65, 98) mm; (65, 0, 98) also tested. Note the X sign: -65 (the payload centre-of-mass
       value, given in Dobot's flange frame) made rotations look wrong on the
       arm, which suggests Link6's X axis is opposite to Dobot's. -->
  <xacro:arg name="tcp_x" default="0.0" />
  <xacro:arg name="tcp_y" default="0.065" />
  <xacro:arg name="tcp_z" default="0.098" />
  <xacro:property name="initial_positions"
                  value="${xacro.load_yaml('$(arg initial_positions_file)')}" />

  <!-- Pull in the full stock robot (fixed to world at z=0.03 by its own world_joint). -->
  <xacro:include filename="$(find dobot_e6_description)/urdf/me6_robot.urdf.xacro" />

  <!-- Ultrasound probe: 30mm dia x 100mm cylinder on the tool axis (+z of Link6). -->
  <link name="us_probe_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.10" />
      </geometry>
      <material name="probe_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4.5e-5" ixy="0" ixz="0" iyy="4.5e-5" iyz="0" izz="5.6e-6" />
    </inertial>
  </link>

  <!-- Tool centre point. MoveIt Servo's chain ends here (servo_moveit_params.yaml),
       so its Jacobian, and therefore every teleop rotation, is about this point, not
       the bare flange. -->
  <link name="probe_tcp" />
  <joint name="probe_tcp_joint" type="fixed">
    <parent link="Link6" />
    <child link="probe_tcp" />
    <origin xyz="$(arg tcp_x) $(arg tcp_y) $(arg tcp_z)" rpy="0 0 0" />
  </joint>

  <!-- FIXED joint to the flange. The FT sensor reads the wrench through it. -->
  <joint name="us_probe_joint" type="fixed">
    <parent link="Link6" />
    <child link="us_probe_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- Keep the fixed joint as a real SDF joint. Without this, sdformat lumps it
       into Link6, the joint vanishes, and the FT sensor below is dropped
       (which also breaks model load => gz_ros2_control => the controllers). -->
  <gazebo reference="us_probe_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>

  <!-- Gazebo Harmonic force/torque sensor on the fixed joint.
       child / child_to_parent => wrench expressed in the probe (child) frame. -->
  <gazebo reference="us_probe_joint">
    <sensor name="ft_sensor" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>ft_sensor</topic>
      <force_torque>
        <frame>child</frame>
        <measure_direction>child_to_parent</measure_direction>
      </force_torque>
    </sensor>
  </gazebo>

  <!-- ForceTorque system plugin: without it the sensor above never publishes. -->
  <gazebo>
    <plugin filename="gz-sim-forcetorque-system"
            name="gz::sim::systems::ForceTorque" />
  </gazebo>

  <!-- gz_ros2_control hardware. Initial values put the arm straight into the
       SRDF "home" pose so it never sits in the all-zeros singularity. -->
  <xacro:macro name="arm_joint" params="jname">
    <joint name="${jname}">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[jname]}</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>

  <ros2_control name="me6_gz" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:arm_joint jname="joint1" />
    <xacro:arm_joint jname="joint2" />
    <xacro:arm_joint jname="joint3" />
    <xacro:arm_joint jname="joint4" />
    <xacro:arm_joint jname="joint5" />
    <xacro:arm_joint jname="joint6" />
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
    </plugin>
  </gazebo>

</robot>
