<?xml version="1.0"?>
<!-- Phantom box for the US probe. Static, single link.
     Scaled down from the Kinova version: E6 reach is only 0.45 m. -->
<sdf version="1.9">
  <model name="green_box">
    <static>true</static>
    <link name="box_link">
      <visual name="visual">
        <geometry>
          <box><size>0.25 0.25 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.0 0.6 0.0 1</ambient>
          <diffuse>0.1 0.8 0.1 1</diffuse>
          <specular>0.1 0.3 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>0.25 0.25 0.15</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
